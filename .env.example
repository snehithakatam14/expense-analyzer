# ──────────────────────────────────────────────────────────────
# AI-Powered Financial Expense Analyzer — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets to version control.
# ──────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# Your OpenAI secret API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...your-key-here...

# ── Optional — OpenAI ─────────────────────────────────────────
# Model to use for transaction categorization.
# gpt-4o-mini is the recommended default (fast, cheap, excellent structured output support)
OPENAI_MODEL=gpt-4o-mini

# Timeout in seconds for each OpenAI API call
OPENAI_TIMEOUT_SECONDS=30.0

# How many times to retry on transient API errors (timeout, rate limit)
MAX_RETRIES=3

# ── Optional — Database ───────────────────────────────────────
# SQLAlchemy connection string.
# SQLite (default, file-based):  sqlite:///./expense_analyzer.db
# SQLite (in-memory for tests):  sqlite:///:memory:
DATABASE_URL=sqlite:///./expense_analyzer.db

# ── Optional — Flask ──────────────────────────────────────────
# development | production | testing
FLASK_ENV=development
FLASK_DEBUG=false

# Change this to a long random string in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Optional — Parser / Categorizer ──────────────────────────
# Number of transactions sent per OpenAI API call (1–100)
CATEGORIZER_BATCH_SIZE=20

# Z-score threshold for statistical anomaly detection (default 2.0 = top 2.3%)
ANOMALY_ZSCORE_THRESHOLD=2.0

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=50
